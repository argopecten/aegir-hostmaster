# Composer-managed dependencies and files
/vendor/
/drush/Commands/contrib/

# Drupal core and contributed projects (installed by Composer)
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/

# Drupal scaffold files (generated by drupal/core-composer-scaffold)
/web/.csslintrc
/web/.editorconfig
/web/.eslintignore
/web/.eslintrc.json
/web/.gitattributes
/web/.ht.router.php
/web/.htaccess
/web/INSTALL.txt
/web/README.md
/web/autoload.php
/web/example.gitignore
/web/index.php
/web/robots.txt
/web/update.php
/web/web.config
/recipes/

# Ignore .gitignore files created by Composer-installed packages
/web/.gitignore
/web/modules/.gitignore
/web/themes/.gitignore
/web/profiles/.gitignore
/web/sites/.gitignore
/web/sites/*/.gitignore
/vendor/**/.gitignore
/drush/**/.gitignore

# User-generated content and files
/web/sites/*/files/
/web/sites/*/private/

# Environment-specific files (generated by scaffold or site-specific)
*.htaccess
/web/sites/sites.php
/web/sites/*/settings.php
/web/sites/*/settings.local.php
/web/sites/*/services*.yml
!/web/sites/default/default.services.yml

# Database credentials
.aegir.db.conf

# Development tools and IDE files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.*.tmp

# Backups and logs
/backups/
*.sql
*.sql.gz
*.log
/web/sites/*/logs/
/drush/cache/
*.backup.*

# Configuration sync (uncomment if not tracking in git)
# /config/sync/
